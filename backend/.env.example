# Copy to backend/.env for local development.
ENVIRONMENT=development
DEFAULT_CURRENCY=INR

# Local embedded PostgreSQL-mode database works out of the box with zero external services;
# switch to external PostgreSQL via JDBC URL as needed:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spends
# SPRING_DATASOURCE_USERNAME=spends
# SPRING_DATASOURCE_PASSWORD=spends
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:h2:file:./spends_dev;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH

CORS_ORIGINS=http://localhost:5173

# Strong secret for staging/production (32+ bytes)
JWT_SECRET=dev-insecure-change-me-dev-insecure-change-me

# Google OAuth client IDs (comma-separated: web, iOS, Android).
# Leave empty locally to use DEV_LOGIN_ENABLED=true instead.
GOOGLE_CLIENT_IDS=
DEV_LOGIN_ENABLED=true

# Cookie settings (set COOKIE_SECURE=false for plain http://localhost dev)
COOKIE_SECURE=false

# 32-byte URL-safe base64 encryption key(s), comma-separated for key rotation
FIELD_ENCRYPTION_KEYS=
