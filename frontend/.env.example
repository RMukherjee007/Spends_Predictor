# Copy to .env.local for local development.

# Google OAuth Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Leave empty to hide the Google button and use dev login instead.
VITE_GOOGLE_CLIENT_ID=

# Shows the passwordless dev login form (requires DEV_LOGIN_ENABLED=true on the backend).
VITE_DEV_LOGIN=true

# Optional: Sentry DSN for frontend error tracking.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development
