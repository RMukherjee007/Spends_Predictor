# Copy to backend/.env for local development.
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_CURRENCY=INR

# Local SQLite works out of the box with zero external services; switch to Postgres as needed:
# DATABASE_URL=postgresql+asyncpg://spends:spends@localhost:5432/spends
DATABASE_URL=sqlite+aiosqlite:///./spends_dev.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# Generate a strong secret for staging/production: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-insecure-change-me-dev-insecure-change-me

# Google OAuth client IDs (comma-separated: web, iOS, Android).
# Leave empty locally to use DEV_LOGIN_ENABLED=true instead.
GOOGLE_CLIENT_IDS=
DEV_LOGIN_ENABLED=true

# Cookie settings (set COOKIE_SECURE=false for plain http://localhost dev)
COOKIE_SECURE=false

# Generate a Fernet key with: `python -m app.scripts.generate_key`
FIELD_ENCRYPTION_KEYS=

# Optional Sentry DSN
SENTRY_DSN=
